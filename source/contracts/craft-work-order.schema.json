{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:craft-work-order",
  "title": "Craft work order",
  "description": "The manufacturing instruction derived from a paid order: bill of materials, process route with equipment assignment, craft constraints inherited from the assessment and the quality-control checkpoints.",
  "type": "object",
  "required": [
    "work_order_id",
    "order_id",
    "concept_id",
    "industry",
    "workshop_id",
    "bom",
    "process_steps",
    "qc_checkpoints",
    "promised_delivery_at",
    "status",
    "created_at"
  ],
  "properties": {
    "work_order_id": { "type": "string", "pattern": "^WO-[0-9]{4}$" },
    "order_id": { "type": "string", "pattern": "^ORD-[0-9]{4}$" },
    "concept_id": { "type": "string", "pattern": "^DC-[0-9]{4}$" },
    "industry": { "$ref": "urn:c2m:contract:common#/$defs/industry" },
    "workshop_id": { "type": "string", "pattern": "^WS-[A-Z]{2}-[A-Z]$" },
    "bom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_id", "material", "spec", "quantity", "unit", "unit_cost_cents"],
        "properties": {
          "line_id": { "type": "string", "pattern": "^BOM-[0-9]{3}$" },
          "material": { "type": "string", "minLength": 1, "maxLength": 40 },
          "spec": { "type": "string", "minLength": 1, "maxLength": 120 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit": { "type": "string", "enum": ["g", "mm", "ml", "piece", "m"] },
          "unit_cost_cents": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "process_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "name", "process", "equipment_id", "est_minutes", "constraints"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^OP-[0-9]{2}$" },
          "name": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "process": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
          "equipment_id": { "type": "string", "pattern": "^EQ-[A-Z0-9-]{2,20}$" },
          "est_minutes": { "type": "integer", "minimum": 1 },
          "constraints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "additionalProperties": false
      }
    },
    "qc_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "name", "method", "pass_criteria", "status"],
        "properties": {
          "checkpoint_id": { "type": "string", "pattern": "^QC-[0-9]{2}$" },
          "name": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "method": { "type": "string", "minLength": 1, "maxLength": 80 },
          "pass_criteria": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "type": "string", "enum": ["pending", "passed", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "promised_delivery_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
    "status": {
      "type": "string",
      "enum": ["issued", "dispatched", "in_production", "completed"]
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false
}
