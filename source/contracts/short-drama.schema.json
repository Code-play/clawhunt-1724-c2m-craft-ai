{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:short-drama",
  "title": "Short drama package",
  "description": "The cultural IP short drama from script to final cut: scenes with beats and bilingual dialogue, a storyboard of timed frames, an edit decision list with continuous timecodes, a subtitle track and the content review. Timecodes are computed from the beat durations, so the cut, the storyboard and the script cannot disagree.",
  "type": "object",
  "required": [
    "drama_id",
    "title",
    "bible_ref",
    "logline",
    "genre",
    "script",
    "storyboard",
    "cut",
    "subtitles",
    "review",
    "created_at"
  ],
  "properties": {
    "drama_id": { "type": "string", "pattern": "^SDR-[0-9]{4}$" },
    "title": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
    "bible_ref": { "type": "string", "pattern": "^IPB-[0-9]{4}$" },
    "logline": { "type": "string", "minLength": 20, "maxLength": 300 },
    "genre": {
      "type": "string",
      "enum": ["mythic_short", "craft_documentary", "comedy_short"]
    },
    "script": {
      "type": "object",
      "required": ["scenes"],
      "properties": {
        "scenes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "scene_id",
              "heading",
              "duration_seconds",
              "characters",
              "beats",
              "assets"
            ],
            "properties": {
              "scene_id": { "type": "string", "pattern": "^SC-[0-9]{2}$" },
              "heading": {
                "type": "object",
                "required": ["int_ext", "location", "time_of_day"],
                "properties": {
                  "int_ext": { "type": "string", "enum": ["INT", "EXT"] },
                  "location": { "type": "string", "minLength": 3, "maxLength": 80 },
                  "time_of_day": { "type": "string", "enum": ["day", "night", "dawn", "dusk"] }
                },
                "additionalProperties": false
              },
              "duration_seconds": { "type": "integer", "minimum": 3, "maximum": 180 },
              "characters": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^CHR-[A-Z0-9-]{2,16}$" }
              },
              "beats": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["beat_id", "summary", "duration_seconds", "dialogue"],
                  "properties": {
                    "beat_id": { "type": "string", "pattern": "^BT-[0-9]{2}$" },
                    "summary": { "type": "string", "minLength": 5, "maxLength": 200 },
                    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
                    "dialogue": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["character_id", "line"],
                        "properties": {
                          "character_id": { "type": "string", "pattern": "^CHR-[A-Z0-9-]{2,16}$" },
                          "line": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "assets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^VA-[A-Z0-9-]{4,28}$" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "storyboard": {
      "type": "object",
      "required": ["frames"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "frame_id",
              "scene_id",
              "shot",
              "camera",
              "duration_seconds",
              "visual_cue",
              "asset_ids"
            ],
            "properties": {
              "frame_id": { "type": "string", "pattern": "^SB-[0-9]{3}$" },
              "scene_id": { "type": "string", "pattern": "^SC-[0-9]{2}$" },
              "shot": {
                "type": "string",
                "enum": ["wide", "medium", "close", "insert", "pov"]
              },
              "camera": {
                "type": "string",
                "enum": ["static", "pan", "push_in", "handheld", "orbit"]
              },
              "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
              "visual_cue": { "type": "string", "minLength": 5, "maxLength": 200 },
              "asset_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^VA-[A-Z0-9-]{4,28}$" }
              },
              "subtitle": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cut": {
      "type": "object",
      "required": ["total_seconds", "timecode_format", "edl", "tracks"],
      "properties": {
        "total_seconds": { "type": "integer", "minimum": 10, "maximum": 600 },
        "timecode_format": { "type": "string", "const": "HH:MM:SS" },
        "edl": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["order", "frame_id", "in_tc", "out_tc", "transition"],
            "properties": {
              "order": { "type": "integer", "minimum": 1, "maximum": 999 },
              "frame_id": { "type": "string", "pattern": "^SB-[0-9]{3}$" },
              "in_tc": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
              "out_tc": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
              "transition": { "type": "string", "enum": ["cut", "dissolve", "fade"] }
            },
            "additionalProperties": false
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["kind", "source", "gain_db"],
            "properties": {
              "kind": { "type": "string", "enum": ["video", "voice", "music", "subtitle"] },
              "source": { "type": "string", "minLength": 3, "maxLength": 160 },
              "gain_db": { "type": "number", "minimum": -24, "maximum": 6 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "subtitles": {
      "type": "object",
      "required": ["language", "lines", "format"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "zh"] },
        "lines": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["in_tc", "out_tc", "text"],
            "properties": {
              "in_tc": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
              "out_tc": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "additionalProperties": false
          }
        },
        "format": { "type": "string", "enum": ["srt", "vtt"] }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "reviewer", "content_review_ref", "authenticity_label", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": "string", "minLength": 2, "maxLength": 60 },
        "content_review_ref": { "type": "string", "pattern": "^CRV-[0-9]{4}$" },
        "authenticity_label": { "type": "string", "minLength": 5, "maxLength": 160 },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 3, "maxLength": 200 }
        }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-DRAMA-01"]
}
