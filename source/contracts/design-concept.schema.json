{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:design-concept",
  "title": "Design concept produced by the creative workstation",
  "description": "One generated concept: source prompt, deterministic seed, palette, form parameters, material, style parameters and the craft facts that the manufacturability assessment consumes. The seed plus the generator version make the concept reproducible.",
  "type": "object",
  "required": [
    "concept_id",
    "title",
    "source",
    "prompt",
    "seed",
    "industry",
    "motif_ids",
    "palette",
    "form",
    "material",
    "style",
    "craft_facts",
    "preview",
    "generator",
    "created_at"
  ],
  "properties": {
    "concept_id": { "type": "string", "pattern": "^DC-[0-9]{4}$" },
    "title": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
    "source": { "type": "string", "enum": ["text", "reference_image", "hybrid"] },
    "prompt": { "$ref": "urn:c2m:contract:common#/$defs/long_i18n_text" },
    "seed": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "industry": { "$ref": "urn:c2m:contract:common#/$defs/industry" },
    "motif_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^MOT-[A-Z]{2}-[0-9]{2}$" }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["hex", "weight"],
        "properties": {
          "hex": { "$ref": "urn:c2m:contract:common#/$defs/hex_color" },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "form": {
      "type": "object",
      "required": ["category", "dimensions_mm", "variant"],
      "properties": {
        "category": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
        "dimensions_mm": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 5000 },
            "y": { "type": "number", "minimum": 0, "maximum": 5000 },
            "z": { "type": "number", "minimum": 0, "maximum": 5000 }
          },
          "additionalProperties": false
        },
        "variant": { "$ref": "urn:c2m:contract:common#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["name", "finish"],
      "properties": {
        "name": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
        "finish": { "$ref": "urn:c2m:contract:common#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": ["style_id", "intensity"],
      "properties": {
        "style_id": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
        "intensity": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["series_id", "sku_index"],
      "properties": {
        "series_id": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
        "sku_index": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "craft_facts": { "type": "object", "minProperties": 1 },
    "preview": {
      "type": "object",
      "required": ["motif_style", "texture", "gradient_angle_deg"],
      "properties": {
        "motif_style": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
        "texture": {
          "type": "string",
          "enum": ["matte", "brushed", "polished", "carved", "woven"]
        },
        "gradient_angle_deg": { "type": "integer", "minimum": 0, "maximum": 360 }
      },
      "additionalProperties": false
    },
    "asset_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^PA-[A-Z]{2}-[0-9]{4}$" }
    },
    "generator": {
      "type": "object",
      "required": ["adapter", "version", "deterministic"],
      "properties": {
        "adapter": { "type": "string", "enum": ["offline_lexicon", "external_api"] },
        "version": { "$ref": "urn:c2m:contract:common#/$defs/semver" },
        "deterministic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 40 },
    "derived_from": { "type": "string", "pattern": "^DC-[0-9]{4}$" },
    "customization_id": { "type": "string", "pattern": "^CUS-[0-9]{4}$" },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false
}
