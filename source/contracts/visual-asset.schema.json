{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:visual-asset",
  "title": "Character visual asset",
  "description": "One visual asset of the character library (turnaround, expression, prop, scene or costume) described as a deterministic drawing recipe plus its provenance: sourcing class, whether AI assisted, the authenticity label, the review state and a checksum over the recipe. The recipe is data, so the browser can draw the asset without a binary file and two builds produce the same picture.",
  "type": "object",
  "required": [
    "asset_id",
    "character_id",
    "kind",
    "view_or_name",
    "recipe",
    "resolution",
    "source",
    "review",
    "checksum",
    "created_at"
  ],
  "properties": {
    "asset_id": { "type": "string", "pattern": "^VA-[A-Z0-9-]{4,28}$" },
    "character_id": { "type": "string", "pattern": "^CHR-[A-Z0-9-]{2,16}$" },
    "kind": {
      "type": "string",
      "enum": ["turnaround", "expression", "prop", "scene", "costume"]
    },
    "view_or_name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "recipe": {
      "type": "object",
      "required": ["background", "layers"],
      "properties": {
        "background": { "$ref": "urn:c2m:contract:common#/$defs/hex_color" },
        "layers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["layer_id", "shape", "fill", "stroke", "stroke_width", "opacity_bp", "geometry", "closed"],
            "properties": {
              "layer_id": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
              "shape": { "type": "string", "enum": ["circle", "rect", "ellipse", "polygon", "path", "line"] },
              "fill": { "$ref": "urn:c2m:contract:common#/$defs/hex_color" },
              "stroke": { "$ref": "urn:c2m:contract:common#/$defs/hex_color" },
              "stroke_width": { "type": "number", "minimum": 0, "maximum": 12 },
              "opacity_bp": { "$ref": "urn:c2m:contract:common#/$defs/rate_bp" },
              "geometry": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "items": { "type": "number", "minimum": 0, "maximum": 1024 }
              },
              "closed": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 256, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 256, "maximum": 2048 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourcing", "ai_assisted", "authenticity_label", "model_refs"],
      "properties": {
        "sourcing": { "type": "string", "enum": ["self_produced", "commissioned", "licensed_cc"] },
        "licence_ref": { "type": "string", "minLength": 3, "maxLength": 120 },
        "ai_assisted": { "type": "boolean" },
        "authenticity_label": { "type": "string", "minLength": 5, "maxLength": 160 },
        "model_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": "string", "minLength": 2, "maxLength": 60 },
        "reviewed_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "checksum": { "$ref": "urn:c2m:contract:common#/$defs/sha256_hex" },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-ASSET-01"]
}
