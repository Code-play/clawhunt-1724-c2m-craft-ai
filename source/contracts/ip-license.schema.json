{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:ip-license",
  "title": "Cultural IP license package",
  "description": "Licensing package for the dual-character cultural IP: character settings, derivative categories, royalty rate, quality specification and the content-review record. Traditional prototypes are referenced, never claimed as exclusive rights.",
  "type": "object",
  "required": [
    "license_id",
    "characters",
    "usage",
    "quality_spec",
    "contract_template_ref",
    "content_review",
    "traditional_prototype_refs",
    "created_at"
  ],
  "properties": {
    "license_id": { "type": "string", "pattern": "^IPL-[0-9]{4}$" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "traits"],
        "properties": {
          "name": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "role": { "type": "string", "minLength": 2, "maxLength": 40 },
          "traits": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "derivative_categories",
        "territory",
        "term_months",
        "exclusivity",
        "royalty_rate_bp"
      ],
      "properties": {
        "derivative_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "jewelry_pendant",
              "apparel_collab",
              "wood_carving_collectible",
              "cultural_gift"
            ]
          }
        },
        "territory": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["CN", "EU", "US", "JP", "global"] }
        },
        "term_months": { "type": "integer", "minimum": 1, "maximum": 120 },
        "exclusivity": { "type": "boolean" },
        "royalty_rate_bp": { "$ref": "urn:c2m:contract:common#/$defs/rate_bp" }
      },
      "additionalProperties": false
    },
    "quality_spec": {
      "type": "object",
      "required": ["material_standard", "packaging", "inspection_points"],
      "properties": {
        "material_standard": { "type": "string", "minLength": 3, "maxLength": 200 },
        "packaging": { "type": "string", "minLength": 3, "maxLength": 200 },
        "inspection_points": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      },
      "additionalProperties": false
    },
    "contract_template_ref": { "type": "string", "minLength": 3, "maxLength": 120 },
    "content_review": {
      "type": "object",
      "required": ["status", "reviewer", "authenticity_label"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": "string", "minLength": 2, "maxLength": 40 },
        "authenticity_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        }
      },
      "additionalProperties": false
    },
    "traditional_prototype_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exclusive_claimed"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "exclusive_claimed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "kind",
          "status",
          "derivative_categories",
          "signatories",
          "file_ref",
          "checksum"
        ],
        "properties": {
          "document_id": { "type": "string", "pattern": "^LICDOC-[0-9]{4}$" },
          "kind": {
            "type": "string",
            "enum": [
              "character_licence",
              "derivative_licence",
              "merchandising",
              "territorial_addendum"
            ]
          },
          "status": { "type": "string", "enum": ["draft", "signed", "archived"] },
          "derivative_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "jewelry_pendant",
                "apparel_collab",
                "wood_carving_collectible",
                "cultural_gift"
              ]
            }
          },
          "signatories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["party", "name", "signed_at"],
              "properties": {
                "party": { "type": "string", "enum": ["licensor", "licensee", "witness"] },
                "name": { "type": "string", "minLength": 2, "maxLength": 60 },
                "signed_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
              },
              "additionalProperties": false
            }
          },
          "file_ref": { "type": "string", "minLength": 5, "maxLength": 160 },
          "checksum": { "$ref": "urn:c2m:contract:common#/$defs/sha256_hex" }
        },
        "additionalProperties": false
      }
    },
    "merch_spec_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^MS-[0-9]{4}$" }
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-IP-01", "INV-IP-02"]
}
