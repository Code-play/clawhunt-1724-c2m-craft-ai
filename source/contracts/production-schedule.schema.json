{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:production-schedule",
  "title": "Workshop production schedule",
  "description": "A deterministic capacity plan for one workshop over a horizon: the working minutes per day, the booked slots (one per work order) and the utilisation per day. The scheduler that produces it is the same code that quotes delivery promises, so a promise can always be explained by the schedule it came from.",
  "type": "object",
  "required": [
    "schedule_id",
    "workshop_id",
    "horizon",
    "capacity_per_day_minutes",
    "slots",
    "utilization",
    "generated_at"
  ],
  "properties": {
    "schedule_id": { "type": "string", "pattern": "^SCH-[0-9]{4}$" },
    "workshop_id": { "type": "string", "pattern": "^WS-[A-Z]{2}-[A-Z]$" },
    "horizon": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
        "to": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "capacity_per_day_minutes": { "type": "integer", "minimum": 60, "maximum": 1440 },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "order_id", "work_order_id", "start", "end", "minutes", "process"],
        "properties": {
          "slot_id": { "type": "string", "pattern": "^SLOT-[0-9]{4}$" },
          "order_id": { "type": "string", "pattern": "^ORD-[0-9]{4}$" },
          "work_order_id": { "type": "string", "pattern": "^WO-[0-9]{4}$" },
          "start": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
          "end": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
          "minutes": { "type": "integer", "minimum": 1 },
          "process": { "$ref": "urn:c2m:contract:common#/$defs/slug" }
        },
        "additionalProperties": false
      }
    },
    "utilization": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "booked_minutes", "capacity_minutes"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "booked_minutes": { "type": "integer", "minimum": 0 },
          "capacity_minutes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "generated_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false
}
