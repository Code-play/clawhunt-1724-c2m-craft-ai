{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:enterprise-profile",
  "title": "Enterprise profile for the shared AI service layer",
  "description": "One enterprise, one profile. The six-industry service layer is assembled from components declared here: switching industry means editing this file, not duplicating code. The FDE handbook and go-live checklist are part of the profile so a deployment cannot be declared done without them.",
  "type": "object",
  "required": [
    "profile_id",
    "enterprise",
    "components",
    "locale",
    "channels",
    "sla",
    "fde",
    "created_at"
  ],
  "properties": {
    "profile_id": { "type": "string", "pattern": "^EP-[0-9]{4}$" },
    "enterprise": {
      "type": "object",
      "required": ["name", "industry", "size", "region"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "industry": { "$ref": "urn:c2m:contract:common#/$defs/industry" },
        "size": { "type": "string", "enum": ["micro", "small", "medium", "large"] },
        "region": { "type": "string", "minLength": 2, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["component_id", "kind", "enabled", "config"],
        "properties": {
          "component_id": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
          "kind": {
            "type": "string",
            "enum": [
              "knowledge_base",
              "agent",
              "workflow",
              "scenario_showcase",
              "crm",
              "growth",
              "commerce",
              "analytics"
            ]
          },
          "enabled": { "type": "boolean" },
          "config": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "locale": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string", "enum": ["zh", "en"] },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["zh", "en", "de", "ja", "ar"] }
        }
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "required": ["site", "seo", "crm"],
      "properties": {
        "site": { "type": "boolean" },
        "seo": { "type": "boolean" },
        "crm": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sla": {
      "type": "object",
      "required": ["first_response_hours", "delivery_days"],
      "properties": {
        "first_response_hours": { "type": "integer", "minimum": 1, "maximum": 240 },
        "delivery_days": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    },
    "fde": {
      "type": "object",
      "required": ["fde_id", "handbook_ref", "go_live_checklist"],
      "properties": {
        "fde_id": { "type": "string", "pattern": "^FDE-[A-Z0-9-]{2,20}$" },
        "handbook_ref": { "type": "string", "minLength": 3, "maxLength": 120 },
        "go_live_checklist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3, "maxLength": 200 }
        }
      },
      "additionalProperties": false
    },
    "data_boundaries": {
      "type": "object",
      "required": ["stores", "cross_border", "dpa_ref"],
      "properties": {
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["store_id", "kind", "region", "personal_data"],
            "properties": {
              "store_id": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
              "kind": {
                "type": "string",
                "enum": ["craft_rules", "orders", "library", "media", "crm", "analytics", "content"]
              },
              "region": { "type": "string", "enum": ["CN", "EU", "US", "JP"] },
              "personal_data": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "cross_border": { "type": "boolean" },
        "dpa_ref": { "type": "string", "minLength": 5, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["mode", "region", "auth_gate", "backup_policy"],
      "properties": {
        "mode": { "type": "string", "enum": ["on_prem", "private_cloud", "saas"] },
        "region": { "type": "string", "enum": ["CN", "EU", "US", "JP"] },
        "auth_gate": { "type": "boolean" },
        "backup_policy": { "type": "string", "minLength": 5, "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "growth": {
      "type": "object",
      "required": ["site_id", "languages", "crm_pipeline"],
      "properties": {
        "site_id": { "type": "string", "pattern": "^SITE-[A-Z0-9-]{3,24}$" },
        "languages": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["zh", "en", "de", "ja", "ar"] }
        },
        "crm_pipeline": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "enum": ["new", "qualified", "contacted", "quoted", "won", "lost"]
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-ENT-01"]
}
