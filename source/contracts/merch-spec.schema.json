{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:merch-spec",
  "title": "Derivative merchandise specification",
  "description": "One derivative category of the cultural IP with its bill of materials, quality tolerances, sampling plan, packaging and rights. The specification is the bridge between the licence document and the factory: the same record feeds the work order BOM and the quality plan, so a merchandising licence cannot be signed without a workable spec.",
  "type": "object",
  "required": [
    "spec_id",
    "category",
    "title",
    "character_ids",
    "license_id",
    "materials",
    "quality",
    "packaging",
    "rights",
    "content_review_ref",
    "created_at"
  ],
  "properties": {
    "spec_id": { "type": "string", "pattern": "^MS-[0-9]{4}$" },
    "category": {
      "type": "string",
      "enum": ["jewelry_pendant", "apparel_collab", "wood_carving_collectible", "cultural_gift"]
    },
    "title": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
    "character_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CHR-[A-Z0-9-]{2,16}$" }
    },
    "license_id": { "type": "string", "pattern": "^IPL-[0-9]{4}$" },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "standard", "sourcing"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 60 },
          "standard": { "type": "string", "minLength": 3, "maxLength": 140 },
          "sourcing": { "type": "string", "enum": ["licensed", "self_produced", "certified"] }
        },
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "required": ["tolerances", "finish", "testing", "inspection_points", "sampling"],
      "properties": {
        "tolerances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "nominal_mm", "tolerance_mm", "method"],
            "properties": {
              "dimension": { "$ref": "urn:c2m:contract:common#/$defs/slug" },
              "nominal_mm": { "type": "number", "minimum": 0, "maximum": 2000 },
              "tolerance_mm": { "type": "number", "minimum": 0.01, "maximum": 20 },
              "method": { "type": "string", "minLength": 2, "maxLength": 80 }
            },
            "additionalProperties": false
          }
        },
        "finish": { "type": "string", "minLength": 3, "maxLength": 160 },
        "testing": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        },
        "inspection_points": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 3, "maxLength": 160 }
        },
        "sampling": {
          "type": "object",
          "required": ["aql", "level"],
          "properties": {
            "aql": { "type": "number", "enum": [1.0, 1.5, 2.5, 4.0, 6.5] },
            "level": { "type": "string", "enum": ["I", "II", "III"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "packaging": {
      "type": "object",
      "required": ["materials", "dimensions_mm", "label_requirements"],
      "properties": {
        "materials": { "type": "string", "minLength": 3, "maxLength": 160 },
        "dimensions_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 1, "maximum": 2000 }
        },
        "label_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3, "maxLength": 160 }
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": ["royalty_rate_bp", "territory", "term_months", "exclusivity"],
      "properties": {
        "royalty_rate_bp": { "$ref": "urn:c2m:contract:common#/$defs/rate_bp" },
        "territory": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["CN", "EU", "US", "JP", "global"] }
        },
        "term_months": { "type": "integer", "minimum": 1, "maximum": 120 },
        "exclusivity": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "content_review_ref": { "type": "string", "pattern": "^CRV-[0-9]{4}$" },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-MERCH-01"]
}
