{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:c2m-order",
  "title": "C2M pre-sale order",
  "description": "A pre-sale order and its lifecycle. Amounts are integer cents; revenue shares are part of the order so the ledger can be reconciled without re-deriving the split policy. The order_event definition is the append-only ledger record.",
  "type": "object",
  "required": [
    "order_id",
    "model",
    "status",
    "buyer",
    "items",
    "amounts",
    "currency",
    "deadline_at",
    "refund",
    "dispute",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "order_id": { "type": "string", "pattern": "^ORD-[0-9]{4}$" },
    "model": {
      "type": "string",
      "enum": ["designer_presale", "participatory_customization", "artist_manufacturer"]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "presale_open",
        "paid",
        "work_order_issued",
        "dispatched",
        "in_production",
        "qc_passed",
        "qc_failed",
        "shipped",
        "settled",
        "disputed",
        "refunded",
        "closed"
      ]
    },
    "buyer": {
      "type": "object",
      "required": ["id", "locale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$" },
        "locale": { "type": "string", "enum": ["en", "zh"] }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "concept_id",
          "title",
          "quantity",
          "unit_price_cents",
          "asset_license_ids",
          "work_order_id",
          "customizations"
        ],
        "properties": {
          "item_id": { "type": "string", "pattern": "^ITM-[0-9]{4}$" },
          "concept_id": { "type": "string", "pattern": "^DC-[0-9]{4}$" },
          "title": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
          "unit_price_cents": { "type": "integer", "minimum": 0 },
          "asset_license_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^PA-[A-Z]{2}-[0-9]{4}$" }
          },
          "work_order_id": { "type": ["string", "null"] },
          "customizations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "customization_id": { "type": ["string", "null"] },
          "edition_id": { "type": ["string", "null"] },
          "edition_number": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    },
    "amounts": {
      "type": "object",
      "required": [
        "subtotal_cents",
        "customization_fee_cents",
        "deposit_cents",
        "total_cents",
        "platform_fee_cents",
        "designer_share_cents",
        "factory_share_cents",
        "ip_share_cents"
      ],
      "properties": {
        "subtotal_cents": { "type": "integer", "minimum": 0 },
        "customization_fee_cents": { "type": "integer", "minimum": 0 },
        "deposit_cents": { "type": "integer", "minimum": 0 },
        "total_cents": { "type": "integer", "minimum": 0 },
        "platform_fee_cents": { "type": "integer", "minimum": 0 },
        "designer_share_cents": { "type": "integer", "minimum": 0 },
        "factory_share_cents": { "type": "integer", "minimum": 0 },
        "ip_share_cents": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "currency": { "type": "string", "enum": ["USD"] },
    "deadline_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
    "promise": {
      "type": "object",
      "required": ["workshop_id", "promised_delivery_at", "slot_id", "working_minutes", "alternatives"],
      "properties": {
        "workshop_id": { "type": "string", "pattern": "^WS-[A-Z]{2}-[A-Z]$" },
        "promised_delivery_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
        "slot_id": { "type": "string", "pattern": "^SLOT-[0-9]{4}$" },
        "working_minutes": { "type": "integer", "minimum": 1 },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workshop_id", "promised_delivery_at"],
            "properties": {
              "workshop_id": { "type": "string", "pattern": "^WS-[A-Z]{2}-[A-Z]$" },
              "promised_delivery_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "refund": {
      "type": "object",
      "required": ["status", "amount_cents", "reason", "requested_at", "decided_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "requested", "approved", "rejected", "refunded"]
        },
        "amount_cents": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"] },
        "requested_at": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dispute": {
      "type": "object",
      "required": ["status", "reason", "resolution_note", "opened_at", "resolved_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "open", "resolved_refund", "resolved_rework", "resolved_split"]
        },
        "reason": { "type": ["string", "null"] },
        "resolution_note": { "type": ["string", "null"] },
        "opened_at": { "type": ["string", "null"] },
        "resolved_at": { "type": ["string", "null"] },
        "qc_record_ids": {
          "type": "array",
          "description": "Quality records cited as evidence when the dispute was opened.",
          "items": { "type": "string", "pattern": "^QCR-[0-9]{4}$" }
        }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
    "updated_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "x-invariants": ["INV-ORDER-01", "INV-PROMISE-01", "INV-DISPUTE-01"],
  "$defs": {
    "order_event": {
      "type": "object",
      "required": [
        "event_id",
        "order_id",
        "seq",
        "at",
        "type",
        "from_status",
        "to_status",
        "actor",
        "payload",
        "prev_hash",
        "hash"
      ],
      "properties": {
        "event_id": { "type": "string", "pattern": "^EVT-[0-9]{4}-[0-9]{4}$" },
        "order_id": { "type": "string", "pattern": "^ORD-[0-9]{4}$" },
        "seq": { "type": "integer", "minimum": 1 },
        "at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" },
        "type": {
          "type": "string",
          "enum": [
            "order_created",
            "presale_opened",
            "payment_received",
            "work_order_issued",
            "dispatched",
            "production_started",
            "qc_passed",
            "qc_failed",
            "shipped",
            "settled",
            "refund_requested",
            "refund_approved",
            "refund_rejected",
            "refunded",
            "dispute_opened",
            "dispute_resolved",
            "rework_started",
            "closed"
          ]
        },
        "from_status": { "type": "string" },
        "to_status": { "type": "string" },
        "actor": { "$ref": "urn:c2m:contract:common#/$defs/actor" },
        "payload": { "type": "object" },
        "prev_hash": { "$ref": "urn:c2m:contract:common#/$defs/sha256_hex" },
        "hash": { "$ref": "urn:c2m:contract:common#/$defs/sha256_hex" }
      },
      "additionalProperties": false
    }
  }
}
