{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:contract:manufacturability-assessment",
  "title": "Two-tier manufacturability assessment",
  "description": "The deterministic engine verdict plus the disposition of the artisan review tier. Every failed rule keeps the fact values that triggered it, so a reviewer can recompute the conclusion without rerunning the engine.",
  "type": "object",
  "required": [
    "assessment_id",
    "concept_id",
    "industry",
    "workshop_id",
    "facts",
    "rule_evaluations",
    "auto",
    "artisan",
    "blockers",
    "fixes",
    "missing_facts",
    "final_verdict",
    "reproducibility",
    "created_at"
  ],
  "properties": {
    "assessment_id": { "type": "string", "pattern": "^MA-[0-9]{4}$" },
    "concept_id": { "type": "string", "pattern": "^DC-[0-9]{4}$" },
    "industry": { "$ref": "urn:c2m:contract:common#/$defs/industry" },
    "workshop_id": { "type": "string", "pattern": "^WS-[A-Z]{2}-[A-Z]$" },
    "facts": { "type": "object", "minProperties": 1 },
    "rule_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "source", "status", "severity", "reason", "facts_used"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^(?:JW|HW)-[A-Z]+-[0-9]{3}$|^CAP-(?:JW|HW)-[A-Z]-[0-9]{2}$"
          },
          "source": { "type": "string", "enum": ["rule", "capability"] },
          "status": { "type": "string", "enum": ["pass", "fail", "na"] },
          "severity": { "type": "string", "enum": ["blocker", "cost", "quality"] },
          "reason": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "facts_used": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        },
        "additionalProperties": false
      }
    },
    "auto": {
      "type": "object",
      "required": ["verdict", "evaluated_rules", "blocking_rules"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["manufacturable", "conditionally_manufacturable", "not_manufacturable"]
        },
        "evaluated_rules": { "type": "integer", "minimum": 0 },
        "blocking_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "artisan": {
      "type": "object",
      "required": ["required", "queue_id", "status", "reviewer", "decision_verdict", "notes", "decided_at"],
      "properties": {
        "required": { "type": "boolean" },
        "queue_id": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["not_required", "pending", "confirmed", "overridden"]
        },
        "reviewer": { "type": ["string", "null"] },
        "decision_verdict": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "text", "suggested_change"],
        "properties": {
          "rule_id": { "type": "string" },
          "text": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
          "suggested_change": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "missing_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "final_verdict": {
      "type": "string",
      "enum": [
        "manufacturable",
        "conditionally_manufacturable",
        "not_manufacturable",
        "not_assessable"
      ]
    },
    "reproducibility": {
      "type": "object",
      "required": ["rules_version", "facts_hash"],
      "properties": {
        "rules_version": { "$ref": "urn:c2m:contract:common#/$defs/semver" },
        "facts_hash": { "$ref": "urn:c2m:contract:common#/$defs/sha256_hex" }
      },
      "additionalProperties": false
    },
    "created_at": { "$ref": "urn:c2m:contract:common#/$defs/timestamp" }
  },
  "additionalProperties": false
}
