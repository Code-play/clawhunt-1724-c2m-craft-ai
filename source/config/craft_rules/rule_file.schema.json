{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2m:config:rule-file",
  "title": "Craft rule file",
  "description": "Structure of a craft rule file: a fact schema plus the rule list. This is the file a craftsperson edits; the lint command validates it against this schema before the engine ever loads it.",
  "type": "object",
  "required": ["industry", "version", "as_of", "facts_schema", "rules"],
  "properties": {
    "industry": { "type": "string", "enum": ["jewelry", "hardwood"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "facts_schema": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "required"],
        "properties": {
          "type": { "type": "string", "enum": ["number", "integer", "string", "boolean", "array"] },
          "required": { "type": "boolean" },
          "unit": { "type": "string", "maxLength": 12 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "enum": { "type": "array", "minItems": 1 },
          "description": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "leaf": {
      "type": "object",
      "required": ["fact", "op"],
      "properties": {
        "fact": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
        "op": {
          "type": "string",
          "enum": ["lt", "lte", "gt", "gte", "eq", "ne", "in", "not_in", "contains_any", "missing", "present"]
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {
            "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/leaf" }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "industry",
        "process",
        "severity",
        "title",
        "when",
        "verdict",
        "reason",
        "fixes",
        "evidence",
        "review",
        "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:JW|HW)-[A-Z]+-[0-9]{3}$" },
        "industry": { "type": "string", "enum": ["jewelry", "hardwood"] },
        "process": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,24}$" },
        "severity": { "type": "string", "enum": ["blocker", "cost", "quality"] },
        "title": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
        "when": { "$ref": "#/$defs/condition" },
        "verdict": {
          "type": "string",
          "enum": ["not_manufacturable", "conditionally_manufacturable"]
        },
        "reason": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
        "fixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "suggested_change"],
            "properties": {
              "text": { "$ref": "urn:c2m:contract:common#/$defs/i18n_text" },
              "suggested_change": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "object",
          "required": ["source_type", "artisan_ref", "captured_at", "reviewed_by", "confidence", "client_confirmation_required"],
          "properties": {
            "source_type": {
              "type": "string",
              "enum": ["synthetic_baseline", "artisan_verbal", "client_document"]
            },
            "artisan_ref": { "type": "string", "minLength": 2, "maxLength": 40 },
            "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            "reviewed_by": { "type": "string", "minLength": 2, "maxLength": 40 },
            "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
            "client_confirmation_required": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": ["tier", "trigger"],
          "properties": {
            "tier": { "type": "string", "enum": ["auto", "artisan"] },
            "trigger": { "type": "string", "enum": ["never", "on_fail", "always"] }
          },
          "additionalProperties": false
        },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      },
      "additionalProperties": false
    }
  }
}
